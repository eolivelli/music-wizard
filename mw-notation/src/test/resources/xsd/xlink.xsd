<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/1999/xlink"
           xmlns:xlink="http://www.w3.org/1999/xlink">
  <xs:attribute name="type">
    <xs:simpleType><xs:restriction base="xs:token">
      <xs:enumeration value="simple"/><xs:enumeration value="extended"/>
      <xs:enumeration value="locator"/><xs:enumeration value="arc"/>
      <xs:enumeration value="resource"/><xs:enumeration value="title"/>
    </xs:restriction></xs:simpleType>
  </xs:attribute>
  <xs:attribute name="href" type="xs:anyURI"/>
  <xs:attribute name="role" type="xs:anyURI"/>
  <xs:attribute name="title" type="xs:string"/>
  <xs:attribute name="show">
    <xs:simpleType><xs:restriction base="xs:token">
      <xs:enumeration value="new"/><xs:enumeration value="replace"/>
      <xs:enumeration value="embed"/><xs:enumeration value="other"/>
      <xs:enumeration value="none"/>
    </xs:restriction></xs:simpleType>
  </xs:attribute>
  <xs:attribute name="actuate">
    <xs:simpleType><xs:restriction base="xs:token">
      <xs:enumeration value="onLoad"/><xs:enumeration value="onRequest"/>
      <xs:enumeration value="other"/><xs:enumeration value="none"/>
    </xs:restriction></xs:simpleType>
  </xs:attribute>
</xs:schema>
