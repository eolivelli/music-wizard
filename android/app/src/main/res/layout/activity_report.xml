<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/reportHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/report_prompt"
            android:textSize="14sp" />

        <!-- saveEnabled="false" because this field's text is already saved, in
             the app's preferences: onPause writes it and onCreate reads it
             back. The framework's own copy is the same fact stored a second
             time, and a second copy of a fact is what every duplicate send on
             this screen has come from — restoring it dispatches a text change
             that is not a person typing, which un-files a take already on
             GitHub and deletes the record saying so. -->
        <EditText
            android:id="@+id/comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/report_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="5"
            android:saveEnabled="false"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/sendButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/report_send" />

            <Button
                android:id="@+id/tokenButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/token_title" />
        </LinearLayout>

        <!-- autoLink so that the comment's URL, which is the only proof the take
             arrived, can be opened rather than copied out by hand. -->
        <TextView
            android:id="@+id/reportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:paddingTop="12dp"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
