<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission. Recordings live in app-private storage, which
         needs none, and nothing here uses the network. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- largeHeap because the analysis holds the whole take as float[] and
             an STFT magnitude matrix over it at the same time; a few minutes of
             audio is past what the default heap gives a phone app. -->

        <activity
            android:name=".RecordActivity"
            android:exported="true"
            android:label="@string/record_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <activity
            android:name=".ResultActivity"
            android:exported="false" />

        <!-- Sharing a take out is the corpus-export path: a WAV recorded in the
             room reaches samples/ or uncommitted/ this way. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
