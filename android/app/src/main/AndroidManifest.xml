<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recordings live in app-private storage, which needs no permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Only ReportActivity opens a socket, and only when its Send button is
         pressed: recording and analysis run with the phone in flight mode.
         Epic #236 listed "no network" as a non-goal and #291 overrode it
         knowingly; android/README.md says why. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- largeHeap because the analysis holds the whole take as float[] and
             an STFT magnitude matrix over it at the same time; a few minutes of
             audio is past what the default heap gives a phone app. -->

        <activity
            android:name=".RecordActivity"
            android:exported="true"
            android:label="@string/record_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <activity
            android:name=".ResultActivity"
            android:exported="false" />

        <!-- configChanges so that turning the phone during an upload does not
             tear this screen down under an in-flight request. It has nothing to
             re-inflate for a new orientation: one column of full-width views. -->
        <activity
            android:name=".ReportActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/report_title" />

        <activity
            android:name=".TokenActivity"
            android:exported="false"
            android:label="@string/token_title" />

        <!-- Sharing a take out is the corpus-export path: a WAV recorded in the
             room reaches samples/ or uncommitted/ this way. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
