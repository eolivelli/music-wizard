  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <!--
          Both test plugins run with XDG_CONFIG_HOME pointed at a directory
          under target/ that nothing ever creates, so the global config layer is
          empty in every forked test JVM. Two modules override the target: the
          ones whose runtime classpath carries real providers point it at the
          committed offline layer under test-config/ instead, whose file says
          why. mw-core cannot share that override: its GlobalConfigLayerTest
          plants and removes files at this location and guards that nothing
          else lives there.

          This is a backstop, not the fix. The fix for #133 is that ConfigLoader
          takes its global config location as an argument, so a test states
          which layer it means instead of inheriting one; that is what mw-core's
          own tests do. But a test that drives a whole command (mw-cli's, and
          the integration tests) goes through the environment-reading path on
          purpose, because exercising the real entry point is the point. Those
          need the environment to be empty rather than to be the developer's.

          Without it, a contributor who is also a user, with the two-line
          paperSize example the README tells them to write, gets a failing test
          naming a config assertion and no hint that their own ~/.config caused
          it, while CI, which has no such file, stays green throughout.

          XDG_CONFIG_HOME alone is enough: globalConfigDirectory() prefers it
          over ~/.config whenever it is set and non-blank, so the home-directory
          branch is never reached. Overriding user.home instead would reach far
          past config into anything that resolves a cache or a toolchain.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <environmentVariables>
              <XDG_CONFIG_HOME>${project.build.directory}/no-global-config</XDG_CONFIG_HOME>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
          <configuration>
            <environmentVariables>
              <XDG_CONFIG_HOME>${project.build.directory}/no-global-config</XDG_CONFIG_HOME>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!--
                  The Android seam. D8 reads class files up to major version 65
                  and rejects anything newer, so a module the app links against
                  that gets compiled at 22+ breaks the app build in a way
                  nothing in this reactor would notice: `mvn verify` stays green
                  and the failure surfaces in a Gradle build most contributors
                  do not run. Raising the target has to be a deliberate edit
                  here, not a side effect of a version bump elsewhere.

                  This checks the property; AndroidBytecodeTargetTest checks the
                  emitted class files, which is what a module-level
                  <release> override would bypass.
                -->
                <requireProperty>
                  <property>maven.compiler.release</property>
                  <regex>^([89]|1[0-9]|2[01])$</regex>
                  <regexMessage>maven.compiler.release must be 21 or lower: Android's D8 rejects class files above major version 65, and the app (#236) links against mw-core, mw-audio, mw-dsp, mw-transcribe, mw-arrange and mw-notation.</regexMessage>
                </requireProperty>
                <!--
                  A denylist of the artifacts we know we must not take, not a
                  licence check: this rule matches coordinates and reads no
                  <licenses> element, so a GPL artifact it does not name enters
                  the graph unremarked. Adding one is what a reviewer does when
                  they find it; CONTRIBUTING.md carries the policy the list
                  serves.
                -->
                <bannedDependencies>
                  <excludes>
                    <exclude>be.tarsos.dsp:*</exclude>
                    <exclude>com.github.axet:TarsosDSP</exclude>
                    <exclude>com.github.st-h:TarsosDSP</exclude>
                    <exclude>com.itextpdf:*</exclude>
                  </excludes>
                  <message>
                    GPL/AGPL dependencies are banned in this Apache-2.0 project.
                    TarsosDSP is GPL-3.0 (and not on Maven Central); iText is
                    AGPL-3.0. See CONTRIBUTING.md.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Slow tests: model downloads, LilyPond invocation, MIDI->audio->Score
      ground-truth loop. Off by default so `mvn verify` stays fast and offline.
    -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
