    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <!--
          Both test plugins run with XDG_CONFIG_HOME pointed at a directory
          under target/ that nothing ever creates, so the global config layer is
          empty in every forked test JVM.

          This is a backstop, not the fix. The fix for #133 is that ConfigLoader
          takes its global config location as an argument, so a test states
          which layer it means instead of inheriting one; that is what mw-core's
          own tests do. But a test that drives a whole command (mw-cli's, and
          the integration tests) goes through the environment-reading path on
          purpose, because exercising the real entry point is the point. Those
          need the environment to be empty rather than to be the developer's.

          Without it, a contributor who is also a user, with the two-line
          paperSize example the README tells them to write, gets a failing test
          naming a config assertion and no hint that their own ~/.config caused
          it, while CI, which has no such file, stays green throughout.

          XDG_CONFIG_HOME alone is enough: globalConfigDirectory() prefers it
          over ~/.config whenever it is set and non-blank, so the home-directory
          branch is never reached. Overriding user.home instead would reach far
          past config into anything that resolves a cache or a toolchain.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <environmentVariables>
              <XDG_CONFIG_HOME>${project.build.directory}/no-global-config</XDG_CONFIG_HOME>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
          <configuration>
            <environmentVariables>
              <XDG_CONFIG_HOME>${project.build.directory}/no-global-config</XDG_CONFIG_HOME>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!--
                  Guard the licensing policy mechanically: GPL/AGPL artifacts
                  must never enter the dependency graph.
                -->
                <bannedDependencies>
                  <excludes>
                    <exclude>be.tarsos.dsp:*</exclude>
                    <exclude>com.github.axet:TarsosDSP</exclude>
                    <exclude>com.github.st-h:TarsosDSP</exclude>
                    <exclude>com.itextpdf:*</exclude>
                  </excludes>
                  <message>
                    GPL/AGPL dependencies are banned in this Apache-2.0 project.
                    TarsosDSP is GPL-3.0 (and not on Maven Central); iText is
                    AGPL-3.0. See CONTRIBUTING.md.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The mutation sweep harness (tools/mutation-sweep.sh) is the one piece of
      this build that is not Java, and it is also the piece whose failures look
      like results: a sweep that reverts an author's uncommitted fix, or counts
      a build error as a killed mutant, reports a number nobody measured. Its
      self-test reproduces each of those failures against a throwaway git
      repository and a stub Maven, so it is fast (about two seconds), offline,
      and touches nothing outside its own temporary directory, which is why it
      belongs in `mvn verify` rather than behind -Pintegration. See #177.

      POSIX only, and not inherited: this runs once, from the aggregator, not
      once per module. Windows has never been exercised here at all (#33).
    -->
    <profile>
      <id>mutation-sweep-selftest</id>
      <activation>
        <os><family>unix</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec.plugin.version}</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>mutation-sweep-selftest</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/tools/mutation-sweep-test.sh</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Slow tests: model downloads, LilyPond invocation, MIDI->audio->Score
      ground-truth loop. Off by default so `mvn verify` stays fast and offline.
    -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
