    <picocli.version>4.7.7</picocli.version>
    <slf4j.version>2.0.18</slf4j.version>
    <logback.version>1.6.0</logback.version>

    <jtransforms.version>3.2</jtransforms.version>           <!-- BSD-2 -->
    <jipes.version>0.9.17</jipes.version>                     <!-- LGPL-2.1 -->
    <ffsampledsp.version>0.9.56</ffsampledsp.version>         <!-- LGPL-2.1 -->
    <onnxruntime.version>1.27.0</onnxruntime.version>         <!-- MIT -->
    <proxymusic.version>4.0.3</proxymusic.version>            <!-- LGPL-3.0 -->
    <anthropic.version>2.52.0</anthropic.version>             <!-- MIT -->

    <junit.version>6.1.2</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <surefire.version>3.5.6</surefire.version>
    <failsafe.version>3.5.6</failsafe.version>
    <compiler.plugin.version>3.15.0</compiler.plugin.version>
