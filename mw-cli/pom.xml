<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.olivelli.musicwizard</groupId>
    <artifactId>music-wizard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mw-cli</artifactId>
  <name>Music Wizard :: CLI</name>
  <description>picocli entry point. The only module that wires everything together.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-core</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-transcribe</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-arrange</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-notation</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-llm</artifactId>
    </dependency>    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>  </dependencies>

  <build>
    <plugins>
      <!--
        The CLI is the one module a user actually runs, so it ships as a single
        executable jar. Without this, running the tool means reconstructing a
        classpath by hand, and the documented `mw` commands do not exist.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>mw</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.olivelli.musicwizard.cli.MusicWizardCommand</mainClass>
                </transformer>
                <!-- Merge service files rather than letting one jar's win; the
                     audio SPI and Jackson both register services this way. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signature files from signed dependencies do not survive
                         being repackaged and make the jar refuse to start. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
