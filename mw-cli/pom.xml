<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.olivelli.musicwizard</groupId>
    <artifactId>music-wizard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mw-cli</artifactId>
  <name>Music Wizard :: CLI</name>
  <description>picocli entry point. The only module that wires everything together.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-core</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-transcribe</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-arrange</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-notation</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-llm</artifactId>
    </dependency>
    <!--
      The provider layer, declared here because this is the module whose job is
      wiring and because the shaded jar is what a desktop user runs. It arrived
      transitively through mw-transcribe until #247 took that edge out to keep
      ONNX Runtime's desktop natives off the phone; the CLI still wants it, so
      it is named here instead of quietly disappearing from the jar.

      Runtime scope: no source in this module compiles against mw-ml, and none
      should, because a provider is chosen at run time.
      MlRuntimeStaysOnTheDesktopTest pins that the jar still gets it.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-ml</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <!--
      Test only. The CLI's MIDI entry point is tested against real Standard MIDI
      Files rather than mocks, because the entry point's whole job is deciding
      what a file is and handing it to the right reader.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The tests here run whole commands, and a command reads the user's global
        config layer at $XDG_CONFIG_HOME/music-wizard/config.yaml. Left alone,
        that makes the suite depend on the machine it runs on: a contributor who
        is also a user, with the paperSize the README tells them to set, gets a
        failure in RenderPartsTest with no visible cause. Pointed at a directory
        under target/ that is never created, so the global layer is reliably
        empty. The same hazard exists reactor-wide (mw-core fails first under the same
        config) and belongs in the parent pom; that is #133, which this module
        does not own the file to fix.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <XDG_CONFIG_HOME>${project.build.directory}/no-global-config</XDG_CONFIG_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
      <!--
        The CLI is the one module a user actually runs, so it ships as a single
        executable jar. Without this, running the tool means reconstructing a
        classpath by hand, and the documented `mw` commands do not exist.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>mw</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.olivelli.musicwizard.cli.MusicWizardCommand</mainClass>
                  <manifestEntries>
                    <!--
                      Two things read this. `mw version` reported "(development
                      build)" from every jar we have ever shipped, because
                      nothing wrote the attribute; and the transcription cache
                      keys on it, so without it a released build served the
                      previous release's analysis for the same input. What it
                      buys is bounded and worth stating: a version change
                      invalidates the cache, so a rebuild at the same version,
                      which is every SNAPSHOT build, still does not. Forcing a
                      recompute is the answer there, and the reuse is announced
                      on every cache hit rather than being silent.
                    -->
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <!-- Merge service files rather than letting one jar's win; the
                     audio SPI and Jackson both register services this way. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signature files from signed dependencies do not survive
                         being repackaged and make the jar refuse to start. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
