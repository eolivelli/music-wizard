<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.olivelli.musicwizard</groupId>
    <artifactId>music-wizard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mw-transcribe</artifactId>
  <name>Music Wizard :: Transcribe</name>
  <description>Stage orchestration: turns audio or MIDI into a Score.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-core</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-audio</artifactId>
    </dependency>    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-dsp</artifactId>
    </dependency>
    <!--
      No mw-ml, deliberately (#247). This module declared it and never wrote a
      line against it, which cost nothing on the desktop and everything on the
      phone: mw-ml's own dependency is ONNX Runtime, whose jar carries desktop
      x86-64 and aarch64 natives, and the Android app (#236) links this module
      for one entry point, transcribe(AudioBuffer, Options), which reaches
      onsets, beats, chroma and chords and no provider at all.

      When a neural stage does arrive (melody #8, separation, lyrics #9), what
      it needs here is the provider SPI, not the ONNX implementations behind
      it; splitting those apart is the work that dependency should wait for.
      Until then mw-cli, the module whose job is wiring, declares mw-ml
      directly. HarmonyPathNeedsNoMlTest holds this side of that line and
      MlRuntimeStaysOnTheDesktopTest in mw-cli holds the other, by checking
      that the CLI still resolves the runtime this module gave up.
    -->
    <!--
      Fixture MIDI for the import tests. Test scope only: mw-testkit depends on
      mw-core alone, so this cannot pull anything into the shipped graph, and the
      fixtures are the same ones mw-notation and mw-arrange build against.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
