<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.olivelli.musicwizard</groupId>
    <artifactId>music-wizard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mw-ml</artifactId>
  <name>Music Wizard :: ML</name>
  <description>Provider SPI for neural stages, ONNX Runtime implementations, and the lazy model cache.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-core</artifactId>
    </dependency>
    <!--
      For the resampler: a provider owns resampling to its model's rate (the
      SPI says so), and duplicating mw-audio's resampler here would be a second
      statement of it. A new edge between non-core modules, named as the rule
      asks. mw-audio is already in every closure that has mw-ml (the CLI has
      both, the phone excludes mw-ml wholesale), so this pulls nothing
      anywhere new.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>mw-audio</artifactId>
    </dependency>
    <!-- The model-side STFT; BSD-2, the same trade mw-dsp makes. -->
    <dependency>
      <groupId>com.github.wendykierp</groupId>
      <artifactId>JTransforms</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
    </dependency>  </dependencies>

  <build>
    <plugins>
      <!-- Same offline layer as mw-cli, same reason: this module IS the real
           providers, and no test of it may reach the network. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <XDG_CONFIG_HOME>${maven.multiModuleProjectDirectory}/test-config</XDG_CONFIG_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <XDG_CONFIG_HOME>${maven.multiModuleProjectDirectory}/test-config</XDG_CONFIG_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The sherpa-onnx ASR provider. A profile, not the default build, because
      its Java API lives in the third_party/sherpa-onnx submodule: a clone
      without the submodule (or without its native build) must still compile
      every other provider. Activates on the submodule's presence; CI builds
      the native separately (cached on the submodule commit) and runs the
      sherpa tests only in that job.
    -->
    <profile>
      <id>sherpa</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/third_party/sherpa-onnx/sherpa-onnx/java-api/pom.xml</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>add-sherpa-sources</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${maven.multiModuleProjectDirectory}/third_party/sherpa-onnx/sherpa-onnx/java-api/src/main/java</source>
                    <source>src/sherpa/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-sherpa-resources</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>add-resource</goal>
                </goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/sherpa/resources</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <id>add-sherpa-test-sources</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/sherpa-test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
