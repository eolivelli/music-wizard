target/
*.class
*.jar
*.war

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/

# OS
.DS_Store
Thumbs.db

# Model cache and workspaces produced by local runs
*.mwz/
models/
.mw-cache/

# The per-worktree local Maven repository. One worktree per task means one
# repository per worktree, and .claude/agents/ names it .m2 inside the
# worktree — so it lands in the working tree, unignored, at the size of the
# whole dependency closure. That is a `git add -A` away from being committed,
# which this repository has been bitten by once already.
.m2/

# Logs
*.log
logs/

# Local-only test audio: not redistributable, so never committed. Committed
# samples must be our own or permissively licensed — samples/list.txt records
# which each file is, and how to fetch the ones that are missing.
samples/blues-a-90bpm.mp3
samples/blues-shuffle-a-106bpm.mp3
samples/blues-e-90bpm.mp3
samples/bossa-cm.mp3
samples/slow-68-40.mp3
samples/pop-am-f-c-g-144.mp3
# No licence and no provenance were ever recorded for this one, so it was
# untracked rather than replaced by a fetch command (#204).
samples/gmajorblues.mp3

# Commercial recordings for local evaluation only — never committed.
# Only the descriptive list.txt is tracked.
uncommitted/*
!uncommitted/list.txt
